FROM php:8.3-apache

# Installation des dépendances système et extensions PHP (opcache ajouté pour la perf)
RUN apt-get update && apt-get install -y git unzip libicu-dev libzip-dev \
    && docker-php-ext-configure intl \
    && docker-php-ext-install intl pdo pdo_mysql zip opcache

# Fix de la sécurité Git (Dubious ownership)
RUN git config --global --add safe.directory /var/www/html

# Activation du module rewrite d'Apache
RUN a2enmod rewrite

# Modification du DocumentRoot pour pointer sur /public
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}/!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# CONFIGURATION CRITIQUE : Création d'une conf propre pour Symfony au lieu de sed multiples
# Cela garantit que les .htaccess fonctionnent et que les routes sont redirigées vers index.php
RUN echo "<Directory ${APACHE_DOCUMENT_ROOT}>\n\
    AllowOverride All\n\
    Require all granted\n\
    FallbackResource /index.php\n\
</Directory>" > /etc/apache2/conf-available/symfony.conf \
    && a2enconf symfony

# Installation de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html